---
// One route for both Greek service pages and blog posts, so they keep their old WordPress URLs (/slug/).
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactCta from '../components/ContactCta.astro';
import ServicePage from '../components/pages/ServicePage.astro';
import { ui } from '../i18n';
import { blogPosting, breadcrumbs } from '../lib/schema';

export async function getStaticPaths() {
  const services = await getCollection('services');
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return [
    ...services.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'service' as const, entry } })),
    ...posts.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'post' as const, entry } })),
  ];
}

const props = Astro.props;
const t = ui.el;
const url = Astro.url.pathname;
const fmt = new Intl.DateTimeFormat('el-GR', { dateStyle: 'long' });

let post: { Content: any; d: any; crumbs: { name: string; url: string }[]; latest: any[] } | null = null;
if (props.kind === 'post') {
  const { Content } = await render(props.entry);
  const d = props.entry.data;
  const latest = (await getCollection('blog', (p) => !p.data.draft && p.id !== props.entry.id))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 3);
  const crumbs = [
    { name: t.home, url: '/' },
    { name: t.blog, url: '/blog-anakthsh-dedomenwn/' },
    { name: d.title, url },
  ];
  post = { Content, d, crumbs, latest };
}
---

{props.kind === 'service' && <ServicePage entry={props.entry} lang="el" />}

{post && (
  <Base title={`${post.d.title} | Datamind`} description={post.d.description} type="article" image={post.d.image}
    schema={[breadcrumbs(post.crumbs), blogPosting({ ...post.d, url })]}>
    <PageHero title={post.d.title} crumbs={post.crumbs}>
      <p class="meta"><time datetime={post.d.date.toISOString()}>{fmt.format(post.d.date)}</time></p>
    </PageHero>
    <div class="wrap section">
      <article class="prose">
        {post.d.image && <img class="post-image" src={post.d.image} alt="" width="800" height="450" />}
        <post.Content />
      </article>
    </div>
    <section class="section section-alt">
      <div class="wrap">
        <div class="section-head">
          <h2>{t.latestPosts}</h2>
          <p><a href="/blog-anakthsh-dedomenwn/">{t.backToBlog} →</a></p>
        </div>
        <ul class="post-grid">
          {post.latest.map((p) => (
            <li>
              <a class="post-card" href={`/${p.id}/`}>
                {p.data.image && <img src={p.data.image} alt="" loading="lazy" width="400" height="225" />}
                <div class="post-card-body">
                  <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
                  <h3>{p.data.title}</h3>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <ContactCta />
  </Base>
)}
