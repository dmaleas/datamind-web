---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { alternateOf, ui, type Lang } from '../i18n';
import { organization } from '../lib/schema';

interface Props {
  title: string; // <title>, shown in Google results
  description: string; // meta description, shown in Google results
  lang?: Lang;
  image?: string;
  type?: 'website' | 'article';
  schema?: object[]; // extra JSON-LD blocks
  noindex?: boolean;
}

const { title, description, lang = 'el', image = '/og-image.png', type = 'website', schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alt = alternateOf(Astro.url.pathname);
const ogImage = new URL(image, Astro.site).href;
const jsonLd = [organization(lang), ...schema];
---

<!doctype html>
<html lang={lang === 'el' ? 'el' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alt.el && <link rel="alternate" hreflang="el" href={new URL(alt.el, Astro.site).href} />}
    {alt.en && <link rel="alternate" hreflang="en" href={new URL(alt.en, Astro.site).href} />}
    {alt.el && <link rel="alternate" hreflang="x-default" href={new URL(alt.el, Astro.site).href} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'el' ? 'el_GR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b2239" />

    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}

    {(site.googleAdsId || site.ga4Id) && (
      <>
        {/*
          Google tag in Consent Mode v2 with everything denied: no cookies are set,
          so no consent banner is needed (GDPR). Google receives cookie-free pings
          and models conversions. url_passthrough keeps the ad click ID (gclid) in
          internal links so a call click on a later page is still attributed.
          If a consent banner is added later, it should call
          gtag('consent', 'update', {...: 'granted'}) after the visitor accepts.
        */}
        <script is:inline define:vars={{ adsId: site.googleAdsId, ga4Id: site.ga4Id, callConversion: site.googleAdsCallConversion }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
          });
          gtag('set', 'url_passthrough', true);
          gtag('js', new Date());
          if (adsId) gtag('config', adsId);
          if (ga4Id) gtag('config', ga4Id);

          // Google Ads conversion "Κλικ για κλήση": any click on a tel: link.
          if (callConversion) {
            document.addEventListener('click', (e) => {
              const link = e.target instanceof Element && e.target.closest('a[href^="tel:"]');
              if (!link) return;
              gtag('event', 'conversion', {
                send_to: callConversion,
                value: 1.0,
                currency: 'EUR',
                transport_type: 'beacon',
              });
            });
          }
        </script>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAdsId || site.ga4Id}`}></script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">{ui[lang].skip}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
