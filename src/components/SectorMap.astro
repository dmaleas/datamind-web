---
// A disk "sector map" as seen during forensic imaging: every block is read in order and marked
// good, slow or unreadable. It fills in once on page load (static when reduced motion is preferred).
import type { Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'el' } = Astro.props;
const en = lang === 'en';

const COLS = 28, ROWS = 14, CELL = 10, GAP = 2;
const total = COLS * ROWS;

// Deterministic pseudo-random numbers so the map is identical on every build.
let seed = 20100101;
const rand = () => ((seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648);

// A scratched band across the platter surface: unreadable and slow blocks cluster here.
const inBand = (r: number, c: number) => r >= 7 && r <= 9 && c >= 9 + (r - 7) * 2 && c <= 19 + (r - 7) * 2;

const cells = Array.from({ length: total }, (_, i) => {
  const r = Math.floor(i / COLS), c = i % COLS;
  const x = rand();
  let state = 'ok';
  if (inBand(r, c)) state = x < 0.45 ? 'bad' : x < 0.8 ? 'slow' : 'ok';
  else if (x < 0.025) state = 'slow';
  else if (x < 0.032) state = 'bad';
  return { x: c * (CELL + GAP), y: r * (CELL + GAP), state, d: ((i / total) * 2.6).toFixed(3) };
});

const w = COLS * (CELL + GAP) - GAP, h = ROWS * (CELL + GAP) - GAP;
const t = en
  ? { title: 'Sector map of a damaged disk', text: 'During imaging every sector of the disk is read and recorded. Damaged areas are read again with special settings, so that as much data as possible is recovered.', ok: 'Read', slow: 'Slow read', bad: 'Unreadable', unread: 'Not yet read' }
  : { title: 'Χάρτης τομέων κατεστραμμένου δίσκου', text: 'Κατά την απεικόνιση (imaging) κάθε τομέας του δίσκου διαβάζεται και καταγράφεται. Οι κατεστραμμένες περιοχές διαβάζονται ξανά με ειδικές ρυθμίσεις, ώστε να ανακτηθεί το μέγιστο δυνατό.', ok: 'Αναγνωσμένοι', slow: 'Αργή ανάγνωση', bad: 'Μη αναγνώσιμοι', unread: 'Προς ανάγνωση' };
---

<figure class="sector-map">
  <svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label={t.title}>
    {cells.map((s) => <rect class={`s ${s.state}`} x={s.x} y={s.y} width={CELL} height={CELL} rx="1.5" style={`--d:${s.d}s`} />)}
  </svg>
  <figcaption>
    <strong>{t.title}</strong>
    <span>{t.text}</span>
    <ul class="legend">
      <li><i class="ok"></i>{t.ok}</li>
      <li><i class="slow"></i>{t.slow}</li>
      <li><i class="bad"></i>{t.bad}</li>
      <li><i class="unread"></i>{t.unread}</li>
    </ul>
  </figcaption>
</figure>
