---
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import { nav, servicesEn, ui, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const en = lang === 'en';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="brand brand-light" href={en ? '/en/' : '/'}>
        <img src="/logo.svg" alt="" width="32" height="32" />
        <span class="brand-name">DATAMIND</span>
      </a>
      <p class="muted">{t.footerAbout}</p>
      <p>
        <a href={`tel:${site.phoneIntl}`}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    <div>
      <h2 class="footer-h">{t.services}</h2>
      <ul class="footer-list">
        {services.map((s) => (
          <li><a href={en && servicesEn[s.id]?.href ? servicesEn[s.id].href : `/${s.id}/`}>{en ? servicesEn[s.id]?.title : s.data.cardTitle}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="footer-h">Datamind</h2>
      <ul class="footer-list">
        {nav(lang).filter((n) => !n.services).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer-h">{t.contact}</h2>
      {site.locations.map((l) => (
        <address class="footer-addr">
          <strong>{en ? l.nameEn : l.name}</strong><br />
          {en ? l.streetEn : l.street}, {en ? l.cityEn : l.city} {l.postalCode}<br />
          <span class="muted">{en ? l.hoursEn : l.hours}</span>
        </address>
      ))}
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© {year} Datamind</span>
    <a href={site.facebook} rel="noopener">Facebook</a>
  </div>
</footer>
