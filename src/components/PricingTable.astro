---
import pricing from '../data/pricing.json';
import { ui, type Lang } from '../i18n';

interface Props { group: string; lang?: Lang; showTitle?: boolean }
const { group, lang = 'el', showTitle = false } = Astro.props;
const g = pricing.groups.find((x) => x.id === group);
const en = lang === 'en';
const t = ui[lang];
---

{g && (
  <section class="pricing-group" aria-labelledby={`price-${g.id}`}>
    {showTitle && (
      <h2 id={`price-${g.id}`}>
        <a href={en ? `/en/${g.serviceEn}/` : `/${g.service}/`}>{en ? g.titleEn : g.title}</a>
      </h2>
    )}
    {!showTitle && <h2 id={`price-${g.id}`}>{t.pricingHeading}</h2>}
    <div class="price-grid">
      {g.items.map((it) => (
        <div class="price-card">
          <h3>{en ? it.nameEn : it.name}</h3>
          <p class="price">{it.price}<span>{t.vat}</span></p>
          <ul>
            {(en ? it.examplesEn : it.examples).map((e) => <li>{e}</li>)}
          </ul>
          <p class="price-free">{t.freeDiagnosis} · {t.freeShipping}</p>
        </div>
      ))}
    </div>
  </section>
)}
