---
import Base from '../../layouts/Base.astro';
import ServiceGrid from '../ServiceGrid.astro';
import Testimonials from '../Testimonials.astro';
import SectorMap from '../SectorMap.astro';
import ContactCta from '../ContactCta.astro';
import home from '../../data/home.json';
import site from '../../data/site.json';
import { getCollection } from 'astro:content';
import { ui, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const h = home[lang];
const en = lang === 'en';
const processHref = en ? '/en/diadikasia_anaktisis/' : '/diadikasia/';
const posts = en ? [] : (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('el-GR', { dateStyle: 'medium' });
---

<Base title={h.seoTitle} description={h.description} lang={lang}>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>{h.heading}</h1>
        <p class="lead">{h.lead}</p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href={`tel:${site.phoneIntl}`}>{h.ctaPrimary} {site.phone}</a>
          <a class="text-link" href={processHref}>{h.ctaSecondary}</a>
        </div>
      </div>
      <SectorMap lang={lang} />
    </div>
    <div class="wrap">
      <ul class="facts" aria-label={en ? 'Why Datamind' : 'Γιατί Datamind'}>
        {h.features.map((f) => (
          <li><strong>{f.title}</strong><span>{f.text}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <div class="section-head">
        <h2>{h.servicesHeading}</h2>
        <p>{h.servicesLead}</p>
      </div>
      <ServiceGrid lang={lang} />
    </div>
  </section>

  {!en && (
    <section class="section section-alt">
      <div class="wrap">
        <div class="section-head"><h2>{h.testimonialsHeading}</h2></div>
        <Testimonials limit={3} />
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>{ui.el.latestPosts}</h2>
          <p><a href="/blog-anakthsh-dedomenwn/">{ui.el.backToBlog}</a></p>
        </div>
        <ul class="post-grid">
          {posts.map((p) => (
            <li>
              <a class="post-card" href={`/${p.id}/`}>
                {p.data.image && <img src={p.data.image} alt="" loading="lazy" width="400" height="225" />}
                <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
                <h3>{p.data.title}</h3>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <ContactCta lang={lang} heading={h.ctaHeading} text={h.ctaText} />
</Base>
