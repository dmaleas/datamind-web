---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import site from '../../data/site.json';
import { ui, type Lang } from '../../i18n';
import { breadcrumbs } from '../../lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const t = ui[lang];
const crumbs = [
  { name: t.home, url: en ? '/en/' : '/' },
  { name: t.contact, url: Astro.url.pathname },
];
const title = en ? 'Contact | Datamind data recovery, Athens & Patras' : 'Επικοινωνία | Datamind ανάκτηση δεδομένων Αθήνα & Πάτρα';
const description = en
  ? 'Contact Datamind on +30 211 800 1320 or at info@datamind.gr. Offices in Athens and at the Patras Science Park. Free courier shipping from anywhere in Greece.'
  : 'Επικοινωνήστε με τη Datamind στο 211 800 1320 ή στο info@datamind.gr. Γραφεία στην Αθήνα και στο Επιστημονικό Πάρκο Πατρών. Δωρεάν μεταφορά από όλη την Ελλάδα.';
const intro = en
  ? 'Our engineers are at your disposal to assess your case. Free courier collection can be arranged from anywhere in Greece.'
  : 'Οι μηχανικοί μας είναι στη διάθεσή σας για την αξιολόγηση της περίπτωσής σας. Η δωρεάν παραλαβή του αποθηκευτικού μέσου μέσω courier είναι διαθέσιμη σε όλη την Ελλάδα.';
---

<Base title={title} description={description} lang={lang} schema={[breadcrumbs(crumbs)]}>
  <PageHero title={t.contact} intro={intro} crumbs={crumbs}>
    <div class="hero-actions">
      <a class="btn btn-accent btn-lg" href={`tel:${site.phoneIntl}`}>{t.phoneLabel} {site.phone}</a>
      <a class="btn btn-ghost btn-lg" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </PageHero>
  <div class="wrap section">
    <div class="location-grid">
      {site.locations.map((l) => (
        <section class="location">
          <h2>{en ? l.nameEn : l.name}</h2>
          <address>
            {en ? l.streetEn : l.street}<br />
            {en ? l.cityEn : l.city} {l.postalCode}
          </address>
          <dl>
            {l.phones.map((ph) => (<><dt>{en ? ph.labelEn : ph.label}</dt><dd><a href={`tel:${ph.intl}`}>{ph.number}</a></dd></>))}
            <dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
            <dt>{t.hours}</dt><dd>{en ? l.hoursEn : l.hours}</dd>
          </dl>
          <iframe
            class="map"
            src={`https://maps.google.com/maps?q=${encodeURIComponent(l.mapQuery)}&z=15&hl=${en ? 'en' : 'el'}&output=embed`}
            title={`${en ? 'Map' : 'Χάρτης'}: ${en ? l.nameEn : l.name}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </section>
      ))}
    </div>
    {site.reviewUrl && (
      <section class="review-cta">
        <h2>{en ? 'Rate our services' : 'Αξιολογήστε τις υπηρεσίες μας'}</h2>
        <p>
          {en
            ? 'If you were satisfied with our work, a short review on Google helps other customers find us.'
            : 'Εάν μείνατε ικανοποιημένοι από τη συνεργασία μας, μια σύντομη αξιολόγηση στο Google βοηθά και άλλους πελάτες να μας βρουν.'}
        </p>
        <a class="btn btn-accent" href={site.reviewUrl} target="_blank" rel="noopener">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z"/></svg>
          {en ? 'Review us on Google' : 'Αξιολογήστε μας στο Google'}
        </a>
      </section>
    )}
  </div>
</Base>
