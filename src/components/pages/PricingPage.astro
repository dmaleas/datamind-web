---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import PricingTable from '../PricingTable.astro';
import ContactCta from '../ContactCta.astro';
import pricing from '../../data/pricing.json';
import { ui, type Lang } from '../../i18n';
import { breadcrumbs } from '../../lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const t = ui[lang];
const crumbs = [
  { name: t.home, url: en ? '/en/' : '/' },
  { name: t.pricingHeading, url: Astro.url.pathname },
];
const title = en ? 'Data recovery prices | Datamind' : 'Κόστος ανάκτησης δεδομένων | Τιμές | Datamind';
const description = en
  ? 'Data recovery prices for hard disks, SSDs, USB flash drives and SD cards. Shipping, diagnosis and donor parts included. No data, no charge.'
  : 'Τιμές ανάκτησης δεδομένων από σκληρούς δίσκους, SSD, USB και κάρτες SD. Η μεταφορά, η διάγνωση και τα ανταλλακτικά περιλαμβάνονται. Χωρίς κρυφές χρεώσεις.';
const intro = en
  ? 'Datamind provides high-quality data recovery services at reasonable cost. Prices include shipping, diagnosis and donor parts; no hidden or additional charges apply.'
  : 'Η Datamind παρέχει υψηλής ποιότητας υπηρεσίες ανάκτησης δεδομένων με εύλογο κόστος. Οι τιμές περιλαμβάνουν τη μεταφορά, τη διάγνωση και τα ανταλλακτικά, χωρίς κρυφές ή πρόσθετες χρεώσεις.';
---

<Base title={title} description={description} lang={lang} schema={[breadcrumbs(crumbs)]}>
  <PageHero title={t.pricingHeading} intro={intro} crumbs={crumbs} />
  <div class="wrap section">
    {pricing.groups.map((g) => <PricingTable group={g.id} lang={lang} showTitle />)}
    <p class="note">{en ? pricing.vatNoteEn : pricing.vatNote} {t.noDataNoCharge}</p>
    <p class="note">
      {en
        ? 'RAID arrays, servers, virtual machines, tapes and ransomware cases are quoted following diagnosis.'
        : 'Για συστοιχίες RAID, servers, εικονικές μηχανές, tapes και περιπτώσεις ransomware, η κοστολόγηση πραγματοποιείται μετά τη διάγνωση.'}
    </p>
  </div>
  <ContactCta lang={lang} />
</Base>
