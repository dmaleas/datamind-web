---
import { getServices } from '../lib/services';
import type { Lang } from '../i18n';

interface Props { lang?: Lang; exclude?: string }
const { lang = 'el', exclude } = Astro.props;
const services = (await getServices(lang)).filter(({ entry }) => entry.id !== exclude);
---

<ul class="service-list">
  {services.map(({ entry, href }) => (
    <li>
      <a href={href}>
        <h3>{entry.data.cardTitle}</h3>
        <p>{entry.data.cardText}</p>
      </a>
    </li>
  ))}
</ul>
