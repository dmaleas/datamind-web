---
import site from '../data/site.json';
import { ui, type Lang } from '../i18n';

interface Props { lang?: Lang; heading?: string; text?: string }
const { lang = 'el', heading, text } = Astro.props;
const t = ui[lang];
const en = lang === 'en';
---

<section class="call-band">
  <div class="wrap call-inner">
    <div class="call-copy">
      <h2>{heading ?? t.ctaHeading}</h2>
      <p>{text ?? t.ctaText}</p>
    </div>
    <div class="call-number">
      <a href={`tel:${site.phoneIntl}`} aria-label={`${t.phoneLabel} ${site.phone}`}>{site.phone}</a>
      <p>
        {en ? 'or write to' : 'ή γράψτε μας στο'} <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </div>
</section>
