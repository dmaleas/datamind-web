---
// Datamind logo: the hexagonal "d" mark plus the DATAMIND wordmark. Colour follows the surrounding text.
interface Props { size?: number }
const { size = 34 } = Astro.props;
---
<span class="logo">
  <svg class="logo-mark" viewBox="37 14.5 58 76" width={Math.round(size * 58 / 76)} height={size} aria-hidden="true"><path fill="currentColor" d="M87 26.89L87 69.35L66 81.47L45 69.35L45 45.45L66 33.33L66 26.4L39 41.99L39 72.81L66 88.4L93 72.81L93 30.36ZM78.2 21.81L78.2 64.27L66 71.31L53.8 64.27L53.8 50.53L66 43.49L66 36.56L47.8 47.07L47.8 67.73L66 78.24L84.2 67.73L84.2 25.28ZM69.4 16.73L69.4 59.19L66 61.15L62.6 59.19L62.6 55.61L66 53.65L66 46.72L56.6 52.15L56.6 62.65L66 68.08L75.4 62.65L75.4 20.2Z"/></svg>
  <span class="logo-word">DATAMIND</span>
</span>
